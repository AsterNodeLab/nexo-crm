# ---------------------------------------------------------------------------
# NEXO · variables de entorno
# Copia a .env.local para desarrollo. NUNCA subas .env a Git.
# Todo lo que dice "PEGAR AQUÍ" se completa en la pantalla /canales de la app.
# ---------------------------------------------------------------------------

# --- Núcleo ---------------------------------------------------------------
DATABASE_URL=postgres://nexo:nexo@localhost:5432/nexo
DIRECT_URL=postgres://nexo:nexo@localhost:5432/nexo
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
APP_URL=http://localhost:3000

# Token interno para /api/internal/ingest (adapters -> nucleus)
INGEST_TOKEN=cambia-esto-tambien
# Token para /api/cron/tick (Vercel Cron o cron local)
CRON_SECRET=cambia-esto-tambien

# --- IA -------------------------------------------------------------------
OPENROUTER_API_KEY=PEGA_AQUÍ_TU_KEY_DE_OPENROUTER
OPENROUTER_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
AI_ENABLED=true
AI_MAX_TOKENS=600
AI_PROPOSAL_TTL_MINUTES=30
# Coste máximo mensual aproximado en USD; el orquestador deja de proponer al superarlo
AI_MONTHLY_BUDGET_USD=10

# --- Telegram (adapter de entrada y aprobación) ---------------------------
TELEGRAM_BOT_TOKEN=PEGA_AQUÍ_EL_TOKEN_DE_BOTFATHER
TELEGRAM_WEBHOOK_SECRET=PEGA_AQUÍ_UN_SECRETO_ALEATORIO
# chat_id permitidos para aprobar, separados por coma. Whitelist obligatoria.
TELEGRAM_APPROVER_CHAT_IDS=PEGA_AQUÍ_TU_CHAT_ID

# --- WhatsApp Cloud API (Meta) --------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=PEGA_AQUÍ_UN_TOKEN_DE_VERIFICACIÓN
WHATSAPP_API_VERSION=v23.0

# --- Instagram Graph API (Meta) -------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=PEGA_AQUÍ_OTRO_TOKEN_DE_VERIFICACIÓN
INSTAGRAM_API_VERSION=v23.0

# --- Email (opcional, fase 2) ---------------------------------------------
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM="Nexo <soporte@tudominio.com>"

# --- Almacenamiento de adjuntos -------------------------------------------
# En local: MinIO. En Vercel: Cloudflare R2 / S3 / Supabase Storage.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nexo
S3_ACCESS_KEY=nexo
S3_SECRET_KEY=nexo
S3_FORCE_PATH_STYLE=true

# --- Webhooks salientes (n8n u otros consumidores) ------------------------
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=PEGA_AQUÍ_UN_HMAC_SECRET

# --- Arranque -------------------------------------------------------------
SEED_OWNER_PASSWORD=nexo123

# --- Modo -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
